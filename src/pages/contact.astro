---
import Layout from '../layouts/Layout.astro';

const email = 'hdj@inu.ac.kr';

const googleMapsEmbedUrl =
  'https://www.google.com/maps/embed?pb=!1m5!3m3!1m2!1s0x357b773dd21f6c8f%3A0x6b37b89ce45b9016!2z7J247LKc64yA7ZWZ6rWQIOqzteqzvOuMgO2VmQ!5e0!3m2!1sko!2skr!4v1784378677878!5m2!1sko!2skr';

const googleMapsLink =
  'https://www.google.com/maps/search/?api=1&query=%EC%9D%B8%EC%B2%9C%EB%8C%80%ED%95%99%EA%B5%90+%EA%B3%B5%EA%B3%BC%EB%8C%80%ED%95%99';
---

<Layout title="Contact">
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-20">
    <header class="mb-12 max-w-3xl">
      <h1 
        class="text-4xl font-bold tracking-tight text-gray-900"
        data-i18n-key="contact.title"
      >
        Contact
      </h1>

      <p 
        class="mt-4 text-lg leading-8 text-gray-600"
        data-i18n-key="contact.subtitle"
      >
        For research collaboration, student opportunities, or general
        inquiries, please contact MIDAS Lab.
      </p>
    </header>

    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-stretch"
    >

      <!-- Contact information -->
      <section
        class="h-full rounded-2xl border border-gray-100 bg-white p-6 shadow-sm sm:p-8"
        aria-labelledby="contact-information-heading"
      >
        <h2
          id="contact-information-heading"
          class="text-2xl font-bold text-gray-900"
          data-i18n-key="contact.getInTouch"
        >
          Get in Touch
        </h2>

        <p 
          class="mt-2 leading-7 text-gray-500"
          data-i18n-key="contact.labFullName"
        >
          Machine Intelligence &amp; Data Science Lab
        </p>

        <div class="mt-8 space-y-8">

          <div>
            <h3
              class="text-xs font-semibold uppercase tracking-wider text-gray-400"
              data-i18n-key="contact.laboratory"
            >
              Laboratory
            </h3>

            <p class="mt-2 text-lg font-semibold text-gray-900">
              MIDAS Lab
            </p>

            <p 
              class="mt-1 leading-7 text-gray-600"
              data-i18n-key="contact.labFullName"
            >
              Machine Intelligence &amp; Data Science Lab
            </p>
          </div>


          <div>
            <h3
              class="text-xs font-semibold uppercase tracking-wider text-gray-400"
              data-i18n-key="contact.affiliation"
            >
              Affiliation
            </h3>

            <p 
              class="mt-2 leading-7 text-gray-700"
              data-ko="바이오-로봇시스템공학과"
              data-en="Department of Biomedical and Robotics Engineering"
            >
              Department of Biomedical and Robotics Engineering
            </p>

            <p 
              class="leading-7 text-gray-700"
              data-ko="인천대학교"
              data-en="Incheon National University"
            >
              Incheon National University
            </p>
          </div>


          <div>
            <h3
              class="text-xs font-semibold uppercase tracking-wider text-gray-400"
              data-i18n-key="contact.address"
            >
              Mailing Address
            </h3>

            <address class="mt-2 not-italic leading-7 text-gray-700">
              <div data-content-lang="en">
                <p>Engineering Building 8, Wing C, Room 532</p>
                <p>Incheon National University</p>
                <p>119 Academy-ro, Yeonsu-gu</p>
                <p>Incheon 22012, Republic of Korea</p>
              </div>

              <div data-content-lang="ko">
                <p>인천광역시 연수구 아카데미로 119 (송도동)</p>
                <p>인천대학교 공과대학</p>
                <p>8호관 C동 532호</p>
                <p>우편번호 22012</p>
              </div>
            </address>
          </div>


          <div>
            <h3
              class="text-xs font-semibold uppercase tracking-wider text-gray-400"
              data-i18n-key="contact.email"
            >
              Email
            </h3>

            <a
              href={`mailto:${email}`}
              class="mt-2 inline-block text-lg font-semibold text-blue-600 transition-colors hover:text-blue-700"
            >
              {email}
            </a>
          </div>

        </div>


        <div class="mt-10 flex flex-wrap gap-3">

          <a
            href={`mailto:${email}`}
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-700"
          >
            <span data-i18n-key="contact.sendEmail">
              Send Email
            </span>
          </a>

          <a
            href={googleMapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg border border-gray-200 px-5 py-2.5 text-sm font-semibold text-gray-700 transition-colors hover:border-blue-200 hover:bg-blue-50 hover:text-blue-600"
          >
            <span data-i18n-key="contact.openMap">
              Open in Google Maps
            </span>
          </a>

        </div>

      </section>


      <!-- Location -->
      <section
        class="flex h-full flex-col"
        aria-labelledby="location-heading"
      >

        <div class="mb-4">

          <h2
            id="location-heading"
            class="text-2xl font-bold text-gray-900"
            data-i18n-key="contact.location"
          >
            Location
          </h2>

          <p
            class="mt-2 text-sm leading-6 text-gray-500"
            data-i18n-key="contact.location.subtitle"
          >
            MIDAS Lab is located in Room 532, Wing C, Engineering Building 8, Incheon National University.
          </p>

        </div>


        <div
          class="flex-1 overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 shadow-sm"
        >

          <iframe
            src={googleMapsEmbedUrl}
            width="100%"
            height="100%"
            style="border: 0;"
            allowfullscreen
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Location of MIDAS Lab at Incheon National University"
            class="block min-h-[440px] w-full"
          >
          </iframe>

        </div>

      </section>

    </div>

  </main>
</Layout>