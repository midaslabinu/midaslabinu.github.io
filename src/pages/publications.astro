---
import Layout from '../layouts/Layout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { getCollection } from 'astro:content';
import { ArrowUp } from 'lucide-react';


const getSortTitle = (
  title:
    | string
    | {
        ko: string;
        en: string;
      }
) => {
  if (typeof title === 'string') {
    return title;
  }

  return title.en;
};

const allPublications = (await getCollection('publications')).sort(
  (a, b) => {
    /*
     * 1. 연도 최신순
     */
    const yearDifference =
      b.data.year - a.data.year;

    if (yearDifference !== 0) {
      return yearDifference;
    }

    /*
     * 2. 같은 연도에서는 게재일 최신순
     *
     * date가 없는 기존 논문은 해당 연도의
     * 1월 1일로 간주합니다.
     */
    const dateA = a.data.date
      ? new Date(a.data.date).getTime()
      : new Date(`${a.data.year}-01-01`).getTime();

    const dateB = b.data.date
      ? new Date(b.data.date).getTime()
      : new Date(`${b.data.year}-01-01`).getTime();

    const dateDifference =
      dateB - dateA;

    if (dateDifference !== 0) {
      return dateDifference;
    }

    /*
     * 3. 날짜도 같으면 제목순
     */
    return getSortTitle(
      a.data.title
    ).localeCompare(
      getSortTitle(b.data.title)
    );
  }
);

const categories = [
  {
    id: 'journal',
    label: {
      ko: '학술지 논문',
      en: 'Journal Articles',
    },
    description: {
      ko: '국제 및 국내 학술지에 게재된 연구 논문',
      en: 'Peer-reviewed journal articles',
    },
    empty: {
      ko: '등록된 학술지 논문이 없습니다.',
      en: 'No journal articles have been added yet.',
    },
  },
  {
    id: 'conference',
    label: {
      ko: '학술대회 논문',
      en: 'Conference Papers',
    },
    description: {
      ko: '학술대회에서 발표된 논문 및 프로시딩',
      en: 'Conference papers and proceedings',
    },
    empty: {
      ko: '등록된 학술대회 논문이 없습니다.',
      en: 'No conference papers have been added yet.',
    },
  },
  {
    id: 'patent',
    label: {
      ko: '특허',
      en: 'Patents',
    },
    description: {
      ko: '등록 및 출원된 특허',
      en: 'Registered and pending patents',
    },
    empty: {
      ko: '등록된 특허가 없습니다.',
      en: 'No patents have been added yet.',
    },
  },
  {
    id: 'book',
    label: {
      ko: '도서 및 북챕터',
      en: 'Books & Book Chapters',
    },
    description: {
      ko: '저서 및 도서에 수록된 북챕터',
      en: 'Books and book chapters',
    },
    empty: {
      ko: '등록된 도서 및 북챕터가 없습니다.',
      en: 'No books or book chapters have been added yet.',
    },
  },
] as const;

type CategoryId = (typeof categories)[number]['id'];

const getCategoryFromId = (id: string): CategoryId => {
  const directoryName = id
    .replace(/\.[^/.]+$/, '')
    .split('/')[0]
    ?.toLowerCase();

  const category = categories.find(
    (item) => item.id === directoryName
  );

  // publications/ 바로 아래에 있는 기존 파일은
  // 임시로 journal에 포함합니다.
  return category?.id ?? 'journal';
};

const getPublicationsByCategory = (
  categoryId: CategoryId
) =>
  allPublications.filter(
    (publication) =>
      getCategoryFromId(publication.id) === categoryId
  );
---

<Layout title="Publications">
  <main
    id="publication-page-top"
    class="mx-auto max-w-5xl px-4 py-12 sm:py-20"
  >
    <!-- =====================================================
         Page Header
         ===================================================== -->
    <header class="mb-12">
      <h1 class="mb-4 text-4xl font-bold text-gray-900">
        <span
          data-ko="연구실적"
          data-en="Publications"
        >
          Publications
        </span>
      </h1>

      <p
        class="max-w-3xl text-lg leading-8 text-gray-600"
        data-ko="MIDAS Lab의 학술지 논문, 학술대회 논문, 특허, 도서 및 북챕터를 소개합니다."
        data-en="A collection of our journal articles, conference papers, patents, books, and book chapters."
      >
        A collection of our journal articles, conference papers,
        patents, books, and book chapters.
      </p>
    </header>

    <!-- =====================================================
         Category Navigation
         ===================================================== -->
    <nav
      aria-label="Publication categories"
      class="mb-16 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm sm:p-5"
    >
      <div
        class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          categories.map((category) => {
            const publications =
              getPublicationsByCategory(category.id);

            return (
              <a
                href={`#${category.id}`}
                class="group flex items-center justify-between rounded-xl bg-gray-50 px-4 py-3 text-sm font-medium text-gray-700 transition-colors hover:bg-blue-50 hover:text-blue-600"
              >
                <span
                  data-ko={category.label.ko}
                  data-en={category.label.en}
                >
                  {category.label.en}
                </span>

                <span
                  class="ml-3 min-w-7 rounded-full border border-gray-200 bg-white px-2 py-0.5 text-center text-xs text-gray-500 shadow-sm transition-colors group-hover:border-blue-200 group-hover:text-blue-600"
                >
                  {publications.length}
                </span>
              </a>
            );
          })
        }
      </div>
    </nav>

    <!-- =====================================================
         Category Sections
         ===================================================== -->
    <div class="space-y-20">
      {
        categories.map((category) => {
          const publications =
            getPublicationsByCategory(category.id);

          const countKo =
            `${publications.length}건`;

          const countEn =
            `${publications.length} ${
              publications.length === 1
                ? 'entry'
                : 'entries'
            }`;

          return (
            <section
              id={category.id}
              class="scroll-mt-28"
              aria-labelledby={`${category.id}-heading`}
            >
              <!-- Category heading -->
              <div
                class="mb-8 border-l-4 border-blue-600 pl-4"
              >
                <div
                  class="flex flex-wrap items-end justify-between gap-4"
                >
                  <div>
                    <h2
                      id={`${category.id}-heading`}
                      class="text-3xl font-bold text-gray-900"
                    >
                      <span
                        data-ko={category.label.ko}
                        data-en={category.label.en}
                      >
                        {category.label.en}
                      </span>
                    </h2>

                    <p class="mt-2 text-sm text-gray-500">
                      <span
                        data-ko={category.description.ko}
                        data-en={category.description.en}
                      >
                        {category.description.en}
                      </span>
                    </p>
                  </div>

                  <span
                    class="text-sm text-gray-500"
                    data-ko={countKo}
                    data-en={countEn}
                  >
                    {countEn}
                  </span>
                </div>
              </div>

              {
                publications.length > 0 ? (
                  <div>
                    {publications.map((publication) => (
                      <PublicationItem
                        entry={publication}
                      />
                    ))}
                  </div>
                ) : (
                  <div
                    class="rounded-2xl border border-dashed border-gray-200 bg-gray-50 px-6 py-10 text-center"
                  >
                    <p
                      class="text-sm text-gray-500"
                      data-ko={category.empty.ko}
                      data-en={category.empty.en}
                    >
                      {category.empty.en}
                    </p>
                  </div>
                )
              }
            </section>
          );
        })
      }
    </div>

    <!-- =====================================================
         Empty Publications
         ===================================================== -->
    {
      allPublications.length === 0 && (
        <div
          class="mt-16 rounded-2xl border border-dashed border-gray-200 bg-gray-50 px-6 py-12 text-center"
        >
          <p class="text-gray-500">
            <span
              data-ko="등록된 연구실적이 없습니다. 다음 경로에 Markdown 파일을 추가하세요:"
              data-en="No publications found. Add Markdown files under:"
            >
              No publications found. Add Markdown files under:
            </span>

            <code
              class="mx-1 rounded bg-gray-100 px-2 py-1 text-sm"
            >
              src/content/publications/
            </code>
          </p>
        </div>
      )
    }
  </main>

  <!-- =====================================================
       Floating Back to Top Button
       ===================================================== -->
  <button
    id="back-to-top"
    type="button"
    aria-label="Back to top"
    title="Back to top"
    class="pointer-events-none fixed bottom-6 right-6 z-50 flex h-12 w-12 translate-y-4 items-center justify-center rounded-full bg-gray-900 text-white opacity-0 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:bg-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-200"
  >
    <ArrowUp className="h-5 w-5" />
  </button>
</Layout>

<script>
  function initializePublicationPage() {
    const page =
      document.querySelector<HTMLElement>(
        '#publication-page-top'
      );

    const backToTopButton =
      document.querySelector<HTMLButtonElement>(
        '#back-to-top'
      );

    if (!page || !backToTopButton) {
      return;
    }

    /*
     * Astro 페이지 전환이나 재초기화 과정에서
     * 이벤트가 중복 등록되는 것을 방지합니다.
     */
    if (
      page.dataset.backToTopInitialized === 'true'
    ) {
      return;
    }

    page.dataset.backToTopInitialized = 'true';

    function updateBackToTopButton() {
      const shouldShow = window.scrollY > 500;

      backToTopButton.classList.toggle(
        'opacity-0',
        !shouldShow
      );

      backToTopButton.classList.toggle(
        'translate-y-4',
        !shouldShow
      );

      backToTopButton.classList.toggle(
        'pointer-events-none',
        !shouldShow
      );

      backToTopButton.classList.toggle(
        'opacity-100',
        shouldShow
      );

      backToTopButton.classList.toggle(
        'translate-y-0',
        shouldShow
      );

      backToTopButton.classList.toggle(
        'pointer-events-auto',
        shouldShow
      );
    }

    backToTopButton.addEventListener(
      'click',
      () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth',
        });
      }
    );

    window.addEventListener(
      'scroll',
      updateBackToTopButton,
      { passive: true }
    );

    updateBackToTopButton();
  }

  initializePublicationPage();

  document.addEventListener(
    'astro:page-load',
    initializePublicationPage
  );
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>